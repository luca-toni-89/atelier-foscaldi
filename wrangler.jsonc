{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"atelier-foscaldi","main":"src/worker.ts","compatibility_date":"2026-08-01",
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/images/*"]},
  "d1_databases":[{"binding":"DB","database_name":"atelier-foscaldi-db","database_id":"REPLACE_AFTER_CREATION","migrations_dir":"migrations"}],
  "r2_buckets":[{"binding":"IMAGES","bucket_name":"atelier-foscaldi-images"}]
}
